{
    "name": "hintio",
    "productName": "Hintio",
    "version": "1.0.5",
    "description": "Hintio",
    "main": "src/index.js",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "package:win": "electron-forge package --platform=win32 --arch=x64",
        "verify:win-package": "node scripts/verify-windows-package.js",
        "make": "electron-forge make",
        "make:win": "electron-forge make --platform=win32 --arch=x64 && npm run verify:win-package && npm run prepare:win-release",
        "publish": "electron-forge publish",
        "lint": "echo \"No linting configured\"",
        "test": "node --test test/*.test.js",
        "typecheck": "node scripts/check-syntax.js",
        "make:win:signed": "node scripts/make-signed-windows.js",
        "prepare:win-release": "node scripts/prepare-windows-release.js",
        "make:store": "node scripts/build-store.js",
        "make:store:validation": "node scripts/build-store.js --validation",
        "verify:store": "node scripts/verify-store-package.js",
        "test:store-ui": "node scripts/store-ui-qa.js",
        "prepare:store-listing": "node scripts/prepare-store-listing.js",
        "test:billing-ui": "node scripts/billing-ui-qa.js"
    },
    "keywords": [
        "Hintio",
        "Hintio ai",
        "Hintio ai assistant",
        "Hintio ai assistant for interviews"
    ],
    "author": {
        "name": "Hintio",
        "email": "hintio@users.noreply.github.com"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@google/genai": "^1.2.0",
        "@huggingface/transformers": "^3.8.1",
        "@vertfrag/rs-capture": "^1.3.0",
        "dotenv": "^17.3.1",
        "electron-squirrel-startup": "^1.0.1",
        "mammoth": "^1.11.0",
        "microsoft-cognitiveservices-speech-sdk": "^1.48.0",
        "ollama": "^0.6.3",
        "pdf-parse": "^1.1.1",
        "tslib": "^2.8.1",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.8.1",
        "@electron-forge/maker-deb": "^7.8.1",
        "@electron-forge/maker-dmg": "^7.8.1",
        "@electron-forge/maker-msix": "7.11.2",
        "@electron-forge/maker-rpm": "^7.8.1",
        "@electron-forge/maker-squirrel": "^7.8.1",
        "@electron-forge/maker-zip": "^7.8.1",
        "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
        "@electron-forge/plugin-fuses": "^7.8.1",
        "@electron/fuses": "^1.8.0",
        "@reforged/maker-appimage": "^5.0.0",
        "electron": "45.2.3",
        "playwright": "1.65.0"
    },
    "overrides": {
        "gaxios": {
            "uuid": "^11.1.1"
        },
        "sharp": "^0.35.4"
    }
}
